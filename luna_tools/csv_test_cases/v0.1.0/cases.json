  },
  "provenance": {
    "creator": "MoonBack / LUNA Tools",
    "data_origin": "Original, hand-authored synthetic item records. No real people, organizations, customer data or external datasets.",
    "references": [
      {
        "id": "rfc4180",
        "url": "https://www.rfc-editor.org/rfc/rfc4180",
        "role": "Informational reference for comma-separated record layout and quoting; not a copied data source."
      },
      {
        "id": "python-csv",
        "url": "https://docs.python.org/3.9/library/csv.html",
        "role": "Reference parser API and newline handling; no external code or data copied."
      }
    ]
  },
  "profile": {
    "id": "luna-csv-comma-utf8-v1",
    "encoding": "utf-8",
    "bom": false,
    "record_separator": "CRLF",
    "final_record_separator": true,
    "scope": "RFC 4180-style record layout and quoting with an explicit UTF-8 extension. Not a claim of full RFC 4180 ABNF conformance or universal parser behavior.",
    "reference_parser": {
      "implementation": "Python standard library csv.reader",
      "python_minimum": "3.9",
      "open_newline": "",
      "delimiter": ",",
      "quotechar": "\"",
      "doublequote": true,
      "escapechar": null,
      "skipinitialspace": false,
      "strict": true,
      "quoting": "QUOTE_MINIMAL"
    },
    "structure": {
      "header": [
        "record_id",
        "label",
        "quantity"
      ],
      "field_count": 3
    },
    "business_rules": {
      "record_id": {
        "required": true,
        "pattern": "T[0-9]{3}",
        "unique": true
      },
      "label": {
        "required": true,
        "blank_definition": "empty or whitespace-only"
      },
      "quantity": {
        "required": true,
        "pattern": "0|[1-9][0-9]*",
        "meaning": "ASCII nonnegative integer text; no sign, decimal point, grouping or leading zeros except zero itself."
      }
    },
    "pipeline": [
      "utf8_decode",
      "csv_parse",
      "record_structure",
      "business_quality"
    ],
    "issue_location": "1-based logical record number, including the header as record 1; not a physical line number.",
    "evaluation_policy": "Do not evaluate structure or quality after parse failure. Do not evaluate business quality after structure failure. No stripping, repairing, filling or type conversion."
  },
